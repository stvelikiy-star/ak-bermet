# ── Google Sheets (заявки) ─────────────────────────────────────
# Скопируйте этот файл в .env.local и заполните значения.
# В production заявки считаются принятыми только после durable-записи.
# Если Google Sheets отключён или не настроен, POST /api/leads работает fail closed
# и возвращает ошибку вместо ложного success.

# Включение интеграции (строго "true" для durable lead storage)
GOOGLE_SHEETS_ENABLED=false

# ID таблицы из URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Сервисный аккаунт
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Приватный ключ: переводы строк экранируйте как \n, оберните в кавычки:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Названия листов (значения по умолчанию можно не менять)
GOOGLE_SHEETS_LEADS_SHEET_NAME=Заявки
GOOGLE_SHEETS_OCCUPANCY_SHEET_NAME=Занятость
GOOGLE_SHEETS_ROOMS_SHEET_NAME=Номерной фонд
GOOGLE_SHEETS_PAYMENTS_SHEET_NAME=Оплаты
GOOGLE_SHEETS_SERVICES_SHEET_NAME=Услуги и цены

# ── AI provider (чат) ──────────────────────────────────────────
# AI_PROVIDER=mock — встроенный безопасный движок.
# AI_PROVIDER=openai + AI_ENABLE_REAL_CALLS=true + OPENAI_API_KEY — реальный AI.
# Если ключа нет или real-вызовы выключены — всегда mock.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=700
AI_ENABLE_REAL_CALLS=false

# ── Кабинет менеджера (Stage 08) ───────────────────────────────
MANAGER_DEMO_MODE=true

# Авторизация менеджера/персонала — только Supabase Auth (см. блок
# ниже и /staff/login). Легаси PIN-cookie (FNV-1a) удалён как
# небезопасный (offline-подбираемый по известному имени cookie и
# низкоэнтропийному PIN) — см. AK_BERMET_CODEX_AUDIT_001.md, H-03.
# Без настроенного Supabase Auth доступ в /manager, /housekeeping,
# /technician не предоставляется никому (fail closed).

# Лист истории изменений заявок
GOOGLE_SHEETS_LEAD_HISTORY_SHEET_NAME=История заявок

# ── Supabase: подключение приложения ───────────────────────────
# URL проекта — не секрет, используется и в браузере, и на сервере.
# URL проекта: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) ключ — Project Settings → API. Безопасен для
# браузера (его прямое назначение) — используется в клиентском коде
# входа/выхода (supabase.auth.*) и в серверном коде, читающем данные
# от имени залогиненного пользователя (работает строго в рамках RLS).
# НЕ путайте с Service Role ключом ниже.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service Role ключ. Даёт полный доступ в обход RLS — используется
# ТОЛЬКО в серверном коде (@/lib/supabase-admin), никогда не
# передаётся в браузер и не коммитится.
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Auth: роли персонала ──────────────────────────────
# Без NEXT_PUBLIC_SUPABASE_URL и NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# страница /staff/login покажет сообщение о том, что Supabase Auth не
# настроен, а /manager, /housekeeping, /technician останутся
# недоступны никому (fail closed). Реальные учётные записи сотрудников
# этим файлом не создаются — заводите их отдельно через одобренный admin flow.

# ── Operator-only production release environment ──────────────
# Эти переменные нужны только оператору для production discovery / migration /
# backup. Значения НЕ коммитить. `npm run preflight:production` проверяет только
# наличие имён/гейтов и никогда не печатает значения секретов.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Прямой PostgreSQL URI только для approved read-only backup script.
# URI не должен содержать query parameters; TLS/read-only принудительно задаются
# самим скриптом. Не передавать URI в командной строке.
AK_BERMET_DATABASE_URL=

# Оставлять пустым по умолчанию. Установить ровно YES только на время явно
# одобренного свежего production backup перед миграциями.
AK_BERMET_BACKUP_APPROVED=
