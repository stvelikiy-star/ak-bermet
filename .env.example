# ── Google Sheets (заявки) ─────────────────────────────────────
# Скопируйте этот файл в .env.local и заполните значения.
# Без GOOGLE_SHEETS_ENABLED=true сайт работает в mock-режиме
# (заявки логируются на сервере, пользователю показывается success).

# Включение интеграции (строго "true", иначе mock-режим)
GOOGLE_SHEETS_ENABLED=false

# ID таблицы из URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Сервисный аккаунт
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Приватный ключ: переводы строк экранируйте как \n, оберните в кавычки:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Названия листов (значения по умолчанию можно не менять)
GOOGLE_SHEETS_LEADS_SHEET_NAME=Заявки
GOOGLE_SHEETS_OCCUPANCY_SHEET_NAME=Занятость
GOOGLE_SHEETS_ROOMS_SHEET_NAME=Номерной фонд
GOOGLE_SHEETS_PAYMENTS_SHEET_NAME=Оплаты
GOOGLE_SHEETS_SERVICES_SHEET_NAME=Услуги и цены

# ── AI provider (чат) ──────────────────────────────────────────
# AI_PROVIDER=mock — встроенный безопасный движок.
# AI_PROVIDER=openai + AI_ENABLE_REAL_CALLS=true + OPENAI_API_KEY — реальный AI.
# Если ключа нет или real-вызовы выключены — всегда mock.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=700
AI_ENABLE_REAL_CALLS=false

# ── Кабинет менеджера (Stage 08) ───────────────────────────────
MANAGER_DEMO_MODE=true

# ── Авторизация менеджера: ЛЕГАСИ РЕЗЕРВНЫЙ ВХОД (Stage 09) ─────
# PIN-защита — временный резервный способ входа в /manager на случай
# проблем с Supabase Auth (см. блок «Supabase Auth» ниже и
# /staff/login — это теперь основной способ входа для персонала).
# Для новых сотрудников заводите Supabase Auth аккаунт, а не PIN.
MANAGER_AUTH_ENABLED=true
MANAGER_ACCESS_PIN=123456
MANAGER_SESSION_COOKIE=akbermet_manager_session
MANAGER_SESSION_HOURS=12

# Лист истории изменений заявок
GOOGLE_SHEETS_LEAD_HISTORY_SHEET_NAME=История заявок

# ── Supabase: подключение проекта (Stage 10-11) ────────────────
# URL проекта — не секрет, используется и в браузере, и на сервере.
# URL проекта: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) ключ — Project Settings → API. Безопасен для
# браузера (его прямое назначение) — используется в клиентском коде
# входа/выхода (supabase.auth.*) и в серверном коде, читающем данные
# от имени залогиненного пользователя (работает строго в рамках RLS).
# НЕ путайте с Service Role ключом ниже.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service Role ключ. Даёт полный доступ в обход RLS — используется
# ТОЛЬКО в серверном коде (@/lib/supabase-admin, только чтение, для
# /manager/operations), никогда не передаётся в браузер и не
# используется для авторизации пользователей. Храните только в
# серверном .env.local, никогда не коммитьте.
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Auth: роли персонала (Stage 11) ────────────────────
# Без NEXT_PUBLIC_SUPABASE_URL и NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# страница /staff/login покажет сообщение о том, что Supabase Auth не
# настроен, а /manager, /housekeeping, /technician останутся
# доступны только через легаси PIN (там, где он включён) — новых
# пользователей создать будет нельзя. Реальные учётные записи
# сотрудников (profiles/user_roles) этим файлом не создаются —
# заводите их через Supabase Dashboard/Admin API отдельно.
